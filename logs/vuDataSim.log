{"level":"debug","node":"System","module":"NodeMemoryProcessor","type":"debug","time":"2025-11-12T23:00:50+05:30","message":"Running ClickHouse query:\n\n\t\tSELECT\n\t\t    CASE\n\t\t        WHEN node_name = 'e2e-83-212' THEN 'clickhouse_node_2'\n        WHEN node_name = 'e2e-82-181' THEN 'kafka_node_1'\n        WHEN node_name = 'e2e-82-234' THEN 'kafka_node_2'\n        WHEN node_name = 'e2e-83-134' THEN 'kafka_node_3'\n        WHEN node_name = 'e2e-83-184' THEN 'clickhouse_node_1'\n\t\t        ELSE node_name\n\t\t    END AS node_label,\n\t\t    ROUND(MAX(memory_used_percent), 2) AS max_memory_used_percent,\n\t\t    ROUND(MIN(memory_used_percent), 2) AS min_memory_used_percent,\n\t\t    ROUND(AVG(memory_used_percent), 2) AS avg_memory_used_percent\n\t\tFROM\n\t\t(\n\t\t    SELECT\n\t\t        b.node_name AS node_name,\n\t\t        ROUND((SUM(b.memory_usage_bytes) / (SUM(b.memory_usage_bytes) + SUM(b.memory_available_bytes))) * 100, 2) AS memory_used_percent\n\t\t    FROM monitoring.kubernetes_node_data AS b\n\t\t    WHERE (b.timestamp >= toDateTime('2025-11-11 20:24:08'))\n\t\t      AND (b.timestamp <= toDateTime('2025-11-11 21:24:16'))\n\t\t      AND (b.node_name IN ('e2e-82-181','e2e-82-234','e2e-83-134','e2e-83-184','e2e-83-212'))\n\t\t    GROUP BY\n\t\t        toStartOfInterval(b.timestamp, toIntervalMinute(5)),\n\t\t        b.node_name\n\t\t) AS node_usage\n\t\tGROUP BY node_label\n\t\tORDER BY node_label ASC\n\t"}
