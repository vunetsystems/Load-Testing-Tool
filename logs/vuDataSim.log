{"level":"debug","node":"System","module":"NodeCPUProcessor","type":"debug","time":"2025-11-13T12:08:02+05:30","message":"Running ClickHouse query:\n\n\t\tSELECT\n\t\t    CASE\n\t\t        WHEN node_name = 'e2e-82-181' THEN 'kafka_node_1'\n        WHEN node_name = 'e2e-82-234' THEN 'kafka_node_2'\n        WHEN node_name = 'e2e-83-134' THEN 'kafka_node_3'\n        WHEN node_name = 'e2e-83-184' THEN 'clickhouse_node_1'\n        WHEN node_name = 'e2e-83-212' THEN 'clickhouse_node_2'\n\t\t        ELSE node_name\n\t\t    END AS node_label,\n\t\t    ROUND(MAX(cpu_used_percent), 2) AS max_cpu_used_percent,\n\t\t    ROUND(MIN(cpu_used_percent), 2) AS min_cpu_used_percent,\n\t\t    ROUND(AVG(cpu_used_percent), 2) AS avg_cpu_used_percent\n\t\tFROM\n\t\t(\n\t\t    SELECT\n\t\t        b.node_name AS node_name,\n\t\t        ROUND(\n\t\t            (SUM(b.cpu_usage_nanocores) / (SUM(b.capacity_cpu_cores) * 1000000000)) * 100,\n\t\t            2\n\t\t        ) AS cpu_used_percent\n\t\t    FROM monitoring.kubernetes_node_data AS b\n\t\t    WHERE (b.timestamp >= toDateTime('2025-11-11 13:05:07'))\n\t\t      AND (b.timestamp <= toDateTime('2025-11-11 14:05:08'))\n\t\t      AND (b.node_name IN ('e2e-83-134','e2e-83-184','e2e-83-212','e2e-82-181','e2e-82-234'))\n\t\t    GROUP BY\n\t\t        toStartOfInterval(b.timestamp, toIntervalMinute(5)),\n\t\t        b.node_name\n\t\t) AS node_usage\n\t\tGROUP BY node_label\n\t\tORDER BY node_label ASC\n\t"}
